# The connector inherits its shape from Microsoft.Extensions.VectorData, so two rules that guard a
# surface we design are off inside this folder only.

[*.cs]

# CA1711: "Rename type so that it does not end in 'Collection'". ZillizCollection is a
# VectorStoreCollection<TKey, TRecord>, and the suffix is the base class rather than a claim that
# this type is a list. Every connector of that package is named this way.
dotnet_diagnostic.CA1711.severity = none

# RS0026: "Do not add multiple overloads with optional parameters". Every overload here is an
# override, and the base class fixes both the count and the defaults. This connector adds none.
dotnet_diagnostic.RS0026.severity = none
