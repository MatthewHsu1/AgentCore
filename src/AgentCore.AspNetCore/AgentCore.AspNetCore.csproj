<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Inbound adapters as Map* extensions: Telnyx Conversation Relay, Telnyx webhooks, chat completions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentCore.Application/AgentCore.Application.csproj" />
    <ProjectReference Include="../AgentCore.Infrastructure/AgentCore.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The one outbound HTTP pipeline of the composition root: pooling, deadline, and retry.
    Microsoft.Extensions.Http itself ships in the shared framework above, so only the retry is a
    package here.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <!-- Rule 2, section 5.1: guard the public surface. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentCore.AspNetCore.Tests" />
  </ItemGroup>

</Project>
